# ==============================================================================
# Scenora Environment Variables Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT:
#   - Never commit actual secrets or the .env file to version control.
#   - Never prefix server secrets with VITE_ (which exposes them to client bundles).
# ==============================================================================

# [Required] TMDB API v3/v4 Read Access Bearer Token
# Obtain from: https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=your_tmdb_api_read_access_token_here

# [Optional] Application Origin (used by SvelteKit for CSRF protection and canonical URLs)
# Example in production: https://scenora.example.com
ORIGIN=http://localhost:5173

# [Optional] Server Network Interface Binding (Default: 127.0.0.1 for local/reverse-proxy)
HOST=127.0.0.1

# [Optional] Production Server Port (Default: 3000)
PORT=3000
